#
#  STEP 2 : Co atom, X2C (two-component) SA-CASSCF / dyall-v2z
#  Ground state 3d7 4s2  4F_9/2
#  Active space: 3d + 4s  -> 6 spatial = 12 spinors, 9 electrons
#
#  Starting orbitals are read from the step-1 spin-free ROHF bin file:
#    chronusq -i co_step1_sfx2c_rohf.inp -o step1.out -b step1.bin
#    chronusq -i co_x2c_casscf.inp       -o step2.out -b step2.bin -s step1.bin
#
[Molecule]
charge = 0
mult = 4
geom:
 Co   0.0   0.0   0.0

[QM]
reference = X2CHF
job = CI

[BASIS]
basis = dyall-v2z

[SCF]
# Do not run the open-shell 2c-HF: take ROHF orbitals (converted to
# spinors) from step1.bin and go straight to CASSCF.
guess = readmo
alg   = skip

[INTS]
alg = incore

[MCSCF]
JOBTYPE   = CASSCF
NACTO     = 12        # spinors (3d x10 + 4s x2)
NACTE     = 9         # 3d7 4s2
NRoots    = 28        # all 28 microstates of the 4F term (J = 9/2,7/2,5/2,3/2)
StateAverage = True   # equal weights -> spherical density, no symmetry breaking
MaxSCFIter   = 300
SCFEneConv   = 1e-8
SCFGradConv  = 1e-5
CIConv       = 1e-8
MaxCIIter    = 200
# --- analysis prints ---
NDetPrint    = 10     # leading determinants per state
PrintConfig  = true   # also print their active-space occupation strings

[MISC]
mem  = 8 GB
nsmp = 8
